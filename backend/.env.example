# ─────────────────────────────────────────────────────────────────────────────
# LEAMSS Portal backend — copy to backend/.env and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
MONGO_URL=mongodb://localhost:27017
DB_NAME=leamss

# REQUIRED. Min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional separate secrets (fall back to JWT_SECRET)
PROPOSAL_LINK_SECRET=
PREVIEW_TOKEN_SECRET=

# --- First admin (used only when the database is empty) -----------------------
INITIAL_ADMIN_EMAIL=admin@leamss.com
INITIAL_ADMIN_PASSWORD=            # leave empty to auto-generate (printed once in logs)
SEED_DEMO_PASSWORD=                # password for demo manager/partner/client accounts
# Local automated tests only — never in production:
# SEED_LEGACY_TEST_PASSWORDS=1

# --- Security -----------------------------------------------------------------
CORS_ORIGINS=https://leamss.com,https://www.leamss.com,https://portal.leamss.com,http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
ALLOW_PUBLIC_SIGNUP=0              # 1 = allow anonymous client self-registration
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_WINDOW_MINUTES=15
# Only behind a TLS-intercepting proxy, local dev only. Prefer SSL_CERT_FILE.
# INSECURE_SKIP_TLS_VERIFY=1

# --- Payments -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# PAYMENT_MODE=mock enables fake "mock pay" endpoints. Local demos only!
PAYMENT_MODE=

# Stripe (optional; Razorpay is the primary gateway)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI / integrations --------------------------------------------------------
# AI features use the provider keys below via the local emergentintegrations
# shim (LiteLLM). Anthropic is used for most Claude-based features.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
RESEND_API_KEY=

# --- Paths (defaults work for a normal checkout) -----------------------------
# APP_ROOT=/app            # folder containing backend/ and frontend/
# UPLOADS_ROOT=/app/uploads
