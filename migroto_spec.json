  "info": {
    "description": "Search and analyze Australian skilled migration occupation data to find ANZSCO codes, visa invitation trends, EOI backlogs, and state nomination opportunities for your migration pathway. Access detailed occupation insights including points distribution patterns to make informed decisions about your skilled migration prospects.",
    "title": "migroto.com API",
    "version": "1.0.0",
    "x-parse-follows-live": true
  },
  "openapi": "3.1.0",
  "paths": {
    "/get_occupation_details": {
      "get": {
        "operationId": "get_occupation_details",
        "parameters": [
          {
            "description": "6-digit ANZSCO occupation code (e.g. '261313' for Software Engineer). Obtainable from search_occupations results.",
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "description": "6-digit ANZSCO occupation code (e.g. '261313' for Software Engineer). Obtainable from search_occupations results.",
              "type": "string"
            }
          },
          {
            "description": "EOI backlog snapshot date in YYYY-MM-DD format (e.g. '2026-06-01'). Available dates retrievable from get_occupation_filters.",
            "in": "query",
            "name": "eoi_date",
            "schema": {
              "description": "EOI backlog snapshot date in YYYY-MM-DD format (e.g. '2026-06-01'). Available dates retrievable from get_occupation_filters.",
              "type": "string"
            }
          },
          {
            "description": "Time range filter for invitations. Examples: 'last-6-months', 'last-fy'.",
            "in": "query",
            "name": "inv_year",
            "schema": {
              "description": "Time range filter for invitations. Examples: 'last-6-months', 'last-fy'.",
              "type": "string"
            }
          },
          {
            "description": "Visa subclass filter for EOI backlog section. Accepted values: 189, 190, 491.",
            "in": "query",
            "name": "eoi_subclass",
            "schema": {
              "description": "Visa subclass filter for EOI backlog section. Accepted values: 189, 190, 491.",
              "enum": [
                "189",
                "190",
                "491"
              ],
              "type": "string"
            }
          },
          {
            "description": "Visa subclass filter for invitations section. Accepted values: 189, 190, 491.",
            "in": "query",
            "name": "inv_subclass",
            "schema": {
              "description": "Visa subclass filter for invitations section. Accepted values: 189, 190, 491.",
              "enum": [
                "189",
                "190",
                "491"
              ],
              "type": "string"
            }
          },
          {
            "description": "UUID of the occupation, obtainable from search_occupations results. Provides faster lookup when supplied.",
            "in": "query",
            "name": "occupation_id",
            "schema": {
              "description": "UUID of the occupation, obtainable from search_occupations results. Provides faster lookup when supplied.",
              "type": "string"
            }
          },
          {
            "description": "Visa subclass filter for EOI trends section. Accepted values: 189, 190, 491.",
            "in": "query",
            "name": "trend_subclass",
            "schema": {
              "description": "Visa subclass filter for EOI trends section. Accepted values: 189, 190, 491.",
              "enum": [
                "189",
                "190",
                "491"
              ],
              "type": "string"
            }
          },
          {
            "description": "Financial year range for EOI trends (e.g. '2025-2026'). Available values retrievable from get_occupation_filters.",
            "in": "query",
            "name": "trend_year_range",
            "schema": {
              "description": "Financial year range for EOI trends (e.g. '2025-2026'). Available values retrievable from get_occupation_filters.",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OccupationInsight"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "description": "Missing or invalid X-API-Key, or the API's authenticated session was lost. Create a key at https://parse.bot/settings."
          },
          "402": {
            "description": "Credit quota exceeded for the billing period."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseErrorEnvelope"
                }
              }
            },
            "description": "Declared for this API — input_not_found: The ANZSCO code does not match any known occupation (upstream returns 404)."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseErrorEnvelope"
                }
              }
            },
            "description": "Stale or invalid input (`status: stale_input`; kinds: input_format_invalid, input_not_found, business_rule_rejected). Correct the input — retrying unchanged will not help."
          },
          "429": {
            "description": "Rate limited. Honor Retry-After before retrying."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseErrorEnvelope"
                }
              }
            },
            "description": "Scraper-side failure (`status: error`; kinds: scraper_bug, extraction_failed). The API needs a revision — retrying will not help."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseErrorEnvelope"
                }
              }
            },
            "description": "Upstream site rejected the request (`status: upstream_error`; carries upstream_status_code + snippet)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseErrorEnvelope"
                }
              }
            },
            "description": "Blocked by site protection (`status: blocked`; kinds: antibot_solvable — retry, the executor rotates; antibot_unsolvable / ip_burned — terminal, do not retry)."
          }
        },
        "security": [
          {
            "apiKeyAuth": []
          }
        ],
        "summary": "Retrieve comprehensive migration data for a single occupation identified by its ANZSCO code. Includes visa subclass eligibility, invitation history, EOI backlog queue position, state nomination programs, points distribution, and EOI trend data. Optional filter parameters narrow the invitation, backlog, and trend sections to a specific visa subclass or date range.",
        "x-parse-price": 1
      }
    },
